# Copy to eglesson.env (gitignored) next to run.sh, or set in systemd/Tomcat. Values in
# server-172.16.56.111.credentials.txt.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=7799
DB_URL=jdbc:mysql://127.0.0.1:3306/eglesson?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=eglesson_app
DB_PASSWORD=
JWT_SECRET=
APP_UPLOAD_DIR=/home/mbank/eglesson/uploads
# First start only: password for the 'admin' account (must be changed at first sign-in).
APP_ADMIN_PASSWORD=
